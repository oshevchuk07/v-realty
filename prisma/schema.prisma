// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BlockType {
  HERO_BANNER
  HORIZONTAL_SLIDER
  ITEM_GRID
  IMAGE_TEXT
}

enum DealType {
  RENT
  SALE
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  LAND
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  RENTED
}

enum UserRole {
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)

  resetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Site Setting
model SiteSettings {
  id Int @id @default(1) //singleton - we must have olvays one record with id = 1;

  siteName    String  @default("Нерухомість")
  logoUrl     String?
  accentColor String  @default("#c89b3c")

  seoTitle       String?
  seoDescription String?

  contactPhone   String?
  contactEmail   String?
  contactAddress String?

  socialFacebook  String?
  socialInstagram String?
  socialTelegram  String?

  updatedAt DateTime @updatedAt
}

model PageBlock {
  id        String    @id @default(uuid())
  page      String    @default("main")
  type      BlockType
  order     Int
  isVisible Boolean   @default(true)
  data      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page, order])
}

// 
model Property {
  id       String         @id @default(cuid())
  dealType DealType
  type     PropertyType
  status   PropertyStatus @default(DRAFT)

  priceUsd Int?
  priceUah Int?

  area        Float
  rooms       Int?
  floor       Int?
  totalFloors Int?

  district    String?
  address     String
  description String  @db.Text

  images       PropertyImage[]
  leadRequests LeadRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dealType])
}

model PropertyImage {
  id         String   @id @default(cuid())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  url      String
  publicId String

  isCover Boolean @default(false)
  order   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([propertyId])
}

model LeadRequest {
  id String @id @default(uuid())

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  name    String
  phone   String
  message String?
  ip      String?

  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([propertyId])
}
